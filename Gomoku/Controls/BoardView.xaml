<UserControl
    x:Class="Gomoku.Controls.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 木质圆角棋盘 -->
        <Border x:Name="BoardFrame"
                Width="800" Height="800"
                CornerRadius="18"
                Background="{ThemeResource BoardBackgroundBrush}"
                BorderBrush="{ThemeResource BoardBorderBrush}"
                BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Canvas x:Name="BoardCanvas"
                    Width="800" Height="800"
                    Background="Transparent"
                    PointerPressed="OnCanvasPointerPressed"
                    PointerMoved="OnCanvasPointerMoved"
                    PointerExited="OnCanvasPointerExited" />
        </Border>
        <!-- 键盘提示：固定在棋盘底部，随棋盘一起缩放，窗口非全屏也不会移位 -->
        <Border x:Name="KeyHintPill"
                CornerRadius="10" Padding="12,4"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Opacity="0.88" IsHitTestVisible="False">
            <TextBlock x:Name="KeyHintText" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
