<ContentDialog
    x:Class="Gomoku.Pages.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    CornerRadius="8">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="540">
        <StackPanel Width="460" Spacing="18" Padding="0,2,0,4">

            <!-- 外观主题（图标+文字横向并列） -->
            <StackPanel Spacing="10">
                <TextBlock x:Name="ThemeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="ThemeSelector" SelectionChanged="OnThemeChanged">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 跟随系统：显示器（带屏幕高光与底座） -->
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center">
                            <Path.Data>
                                <GeometryGroup FillRule="EvenOdd">
                                    <RectangleGeometry Rect="2,3,20,14" />
                                    <RectangleGeometry Rect="5,6,14,8" />
                                    <RectangleGeometry Rect="10,20,4,3" />
                                    <RectangleGeometry Rect="8,23,8,1" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                        <TextBlock x:Name="ThemeSystemText" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="ThemeLightText" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 深色：新月 -->
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                              Data="M14.2,2.4 C18.9,4.2 22.2,8.5 22.2,13.5 C22.2,20.3 16.8,25.8 10,25.8 C5.3,25.8 1.4,23.1 1.4,19.7 C1.4,18.9 1.8,18.3 2.5,18 C3.6,17.5 5.4,17.9 6.9,18.1 C12,18.7 16.4,14.7 16.4,10 C16.4,7.1 15,4.4 13.2,2.7 C12.6,2.2 12.5,1.5 13,0.9 C13.5,0.4 14.2,2.4 14.2,2.4 Z" />
                        <TextBlock x:Name="ThemeDarkText" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButtons>
                <TextBlock x:Name="ThemeHint" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 偏好 -->
            <StackPanel Spacing="10">
                <TextBlock x:Name="PrefsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameTitle" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Width="180" TextChanged="OnNameChanged" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="HintTitle" />
                        <TextBlock x:Name="HintSub" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HintToggle" Grid.Column="1" Toggled="OnHintToggled" />
                </Grid>
            </StackPanel>

            <!-- 语言（跟随系统 / 多语言切换，立即生效） -->
            <StackPanel Spacing="10">
                <TextBlock x:Name="LangTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="LangCombo" MinWidth="220" HorizontalAlignment="Left"
                          SelectionChanged="OnLangChanged" />
                <TextBlock x:Name="LangSub" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 键位 -->
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KeysTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button x:Name="ResetKeysButton" Grid.Column="1" Click="OnResetKeys" />
                </Grid>
                <TextBlock x:Name="CaptureHint" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="KeyList" Spacing="4" />
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="AboutTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="GOMOKU · 1.0.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="AboutLine" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="AboutFeatures" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
